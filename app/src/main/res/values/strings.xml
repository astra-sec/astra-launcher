    <string name="settings_scope_title">当前版本范围</string>
    <string name="settings_scope_body">响应式主页、每日图片、收藏、全部应用、地点天气、系统设置快捷入口、公共 TV 输入源，以及 Activity 浏览、应用权限 Shell 和局域网安装 APK。没有设备模式、悬浮控件、无障碍服务或原厂桌面接管逻辑。</string>
    <string name="data_sources_title">地点与天气数据</string>
